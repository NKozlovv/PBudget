# Copy to .env.local for local dev; set the same names in Vercel (Project → Settings → Environment Variables).

# ── Supabase (public — safe to expose, access is gated by RLS) ────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Invitation links ──────────────────────────────────────────────────────
# Origin used in emailed invite links. Set for Production only; if unset it is
# derived from the request's Host header.
NEXT_PUBLIC_SITE_URL=https://theusapp.vercel.app

# ── Invitation emails (server-only secrets — mark Sensitive in Vercel) ────
# Without these, invites still work: the owner copies the
# link from /members and sends it themselves.
#
# Gmail (no domain needed): Google account → Security → 2-Step
# Verification (must be on) → App passwords. Spaces in the password are ignored.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

