# Public Supabase keys — safe to expose, gated by RLS.
#
# For Vercel: Project → Settings → Environment Variables.
# Add both keys to BOTH the "Preview" environment (so the experimental
# branch deploys can read them) and the "Production" environment (when
# we cut over). Match the values to the same Supabase project that
# master/index.html uses today (see CLAUDE.md §2).
#
# For local dev: copy this file to .env.local and fill in real values.
NEXT_PUBLIC_SUPABASE_URL=https://udcfjiuybkugbydlaltk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── Invitation emails (server-only, NOT public) ───────────────────────────
# Resend (https://resend.com): create an API key and verify a sending domain.
# Without these, invites are still created and the owner can copy the link
# from /members and send it themselves.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Theus <invites@yourdomain.com>"
# Optional. Origin used in emailed links; defaults to the request's own host.
NEXT_PUBLIC_SITE_URL=https://p-budget.vercel.app
